# 카카오 로그인을 로컬에서 실제로 붙여볼 때: cp .env.local.example .env.local 후 값 입력
# .env.local은 git에 올라가지 않는다. 여기 값이 .env보다 우선한다.
AUTH_MOCK=0
KAKAO_REST_API_KEY=
# 카카오 로그인 > 보안 > Client Secret을 켰다면 입력
KAKAO_CLIENT_SECRET=
# 탈퇴 시 연결 해제용(없으면 탈퇴는 되지만 카카오 연결 해제는 건너뜀)
KAKAO_ADMIN_KEY=
# 비우면 PUBLIC_URL(.env의 http://localhost:5173) + /api/auth/kakao/callback
KAKAO_REDIRECT_URI=
