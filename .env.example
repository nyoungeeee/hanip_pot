# 복사해서 .env로 사용. 실제 값은 커밋하지 말 것.
PUBLIC_URL=https://hanippot.example.com
SESSION_SECRET=
# 카카오 Developers > 앱 > 앱 키
KAKAO_REST_API_KEY=
# 카카오 로그인 > 보안 > Client Secret (사용 설정 시)
KAKAO_CLIENT_SECRET=
# 비우면 ${PUBLIC_URL}/api/auth/kakao/callback
KAKAO_REDIRECT_URI=
# 탈퇴 시 연결 해제(unlink)에 사용하는 Admin 키
KAKAO_ADMIN_KEY=
TRUST_PROXY=1
HOST_PORT=3210
BACKUP_HOST_DIR=./backups
BACKUP_KEEP=14
BACKUP_INTERVAL_HOURS=6
